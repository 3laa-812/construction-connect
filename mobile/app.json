{
  "expo": {
    "name": "mobile",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-master.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.x3laar.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-master.png",
        "backgroundColor": "#0D0F0E"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.x3laar.mobile"
    },
    "web": {
      "favicon": "./assets/icon-master.png",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon-master.png",
          "backgroundColor": "#0D0F0E",
          "dark": {
            "backgroundColor": "#0D0F0E"
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Construction Connect to access your camera for Proof of Delivery and Log photos."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Construction Connect to use your location for automatic site weather detection."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
