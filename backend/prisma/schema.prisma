generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// 1. Identity & Onboarding (KYB)
// Handles Multi-role users and Company Verification
enum CompanyType {
  CONTRACTOR
  SUPPLIER
}

enum Role {
  ADMIN
  SITE_ENGINEER
  PROCUREMENT_MANAGER
}

model Company {
  id                String      @id @default(uuid())
  name              String      @db.VarChar(255)
  type              CompanyType
  commercial_reg_no String?     @db.VarChar(100) // KYB Doc
  tax_id            String?     @db.VarChar(100) // KYB Doc
  is_verified       Boolean     @default(false)
  wallet_balance    Decimal     @default(0.00) @db.Decimal(15, 2) // Internal Ledger
  created_at        DateTime    @default(now())

  users User[]

  // Relations: Projects (Owner/Contractor)
  projects Project[]

  // Relations: Marketplace
  bids Bid[] @relation("SupplierBids")

  // Relations: Supply Chain
  purchase_orders_as_supplier PurchaseOrder[] @relation("SupplierPOs")
  products                    Product[]

  // Relations: Finance
  invoices_as_supplier Invoice[]        @relation("SupplierInvoices")
  invoices_as_buyer    Invoice[]        @relation("BuyerInvoices")
  wallets              Wallet[]
  settings             CompanySettings?
  documents            CompanyDocument[]

  @@map("companies")
}

model CompanyDocument {
  id          String   @id @default(uuid())
  company_id  String
  doc_type    String
  file_url    String
  uploaded_at DateTime @default(now())
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@map("company_documents")
}

model Wallet {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id])
  balance    Decimal  @default(0.00) @db.Decimal(15, 2)
  currency   String   @default("SAR") @db.VarChar(3)
  created_at DateTime @default(now())

  transactions Transaction[]

  @@map("wallets")
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  PAYMENT
  REFUND
}

model Transaction {
  id          String          @id @default(uuid())
  wallet_id   String
  wallet      Wallet          @relation(fields: [wallet_id], references: [id])
  amount      Decimal         @db.Decimal(15, 2)
  type        TransactionType
  reference   String? // External Ref ID
  description String?

  // Optional links
  invoice_id     String?
  invoice        Invoice?       @relation(fields: [invoice_id], references: [id])
  po_id          String?
  purchase_order PurchaseOrder? @relation(fields: [po_id], references: [id])

  created_at DateTime @default(now())

  @@map("transactions")
}

model User {
  id            String   @id @default(uuid())
  company_id    String?
  company       Company? @relation(fields: [company_id], references: [id])
  email         String   @unique @db.VarChar(255)
  phone         String?  @unique @db.VarChar(50)
  password_hash String?  @db.VarChar(255)
  role          Role?
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())

  // Relations: Marketplace
  created_rfqs RFQ[]

  // Relations: Supply Chain
  received_delivery_notes DeliveryNote[] // Site Engineer receiving goods

  // Relations: Sync (who made the change)
  sync_changes SyncChange[]
  dailyLogs    DailyLog[]

  notifications Notification[]

  @@map("users")
}

model Notification {
  id         String   @id @default(uuid())
  user_id    String
  title      String   @db.VarChar(255)
  body       String   @db.Text
  type       String   @db.VarChar(64)
  entity_id  String?
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@index([user_id, is_read])
  @@map("notifications")
}

// 2. Project & BOQ Management
// Handles nested Bill of Quantities and Site Locations.
model Project {
  id         String    @id @default(uuid())
  company_id String
  company    Company   @relation(fields: [company_id], references: [id])
  name       String    @db.VarChar(255)
  budget     Decimal?  @db.Decimal(15, 2)
  start_date DateTime? @db.Date
  end_date   DateTime? @db.Date
  created_at DateTime  @default(now())

  sites           Site[]
  boq_items       BOQItem[]
  rfqs            RFQ[]
  purchase_orders PurchaseOrder[]
  dailyLogs       DailyLog[]
  inventories     Inventory[]

  @@map("projects")
}

model Inventory {
  id           String   @id @default(uuid())
  project_id   String
  product_name String
  unit         String
  qty_on_hand  Decimal  @default(0) @db.Decimal(14, 3)
  updated_at   DateTime @updatedAt
  project      Project  @relation(fields: [project_id], references: [id])

  @@unique([project_id, product_name, unit])
  @@map("inventories")
}

model Site {
  id               String   @id @default(uuid())
  project_id       String
  project          Project  @relation(fields: [project_id], references: [id])
  name             String   @db.VarChar(255)
  latitude         Decimal? @db.Decimal(10, 8)
  longitude        Decimal? @db.Decimal(11, 8)
  geofence_polygon Json? // JSONB
  contact_person   String?  @db.VarChar(100)
  contact_phone    String?  @db.VarChar(50)

  @@map("sites")
}

model BOQItem {
  id         String    @id @default(uuid())
  project_id String
  project    Project   @relation(fields: [project_id], references: [id])
  parent_id  String?
  parent     BOQItem?  @relation("BOQHierarchy", fields: [parent_id], references: [id])
  children   BOQItem[] @relation("BOQHierarchy")

  code           String?  @db.VarChar(50) // CSI Code
  description    String?  @db.Text
  quantity       Decimal? @db.Decimal(12, 3)
  unit           String?  @db.VarChar(50)
  estimated_rate Decimal? @db.Decimal(12, 2)

  rfq_items RFQItem[]

  @@map("boq_items")
}

model Product {
  id                  String   @id @default(uuid())
  server_id           String?  @unique // If mapping to external ID
  name                String   @db.VarChar(255)
  category            String   @db.VarChar(100)
  sub_category        String?  @db.VarChar(100)
  unit                String   @db.VarChar(50)
  specifications      Json?
  base_price          Decimal? @db.Decimal(10, 2)
  description         String?  @db.Text
  image_url           String?  @db.Text
  is_active           Boolean  @default(true)
  supplier_company_id String?
  supplier            Company? @relation(fields: [supplier_company_id], references: [id])
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("products")
}

model Category {
  id           String     @id @default(uuid())
  name         String     @unique
  parent_id    String?
  parent       Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children     Category[] @relation("CategoryTree")
  unit_options String[]

  @@map("categories")
}

// 3. RFQ & Marketplace Engine
// Handles the bidding process and awarding.
enum RFQStatus {
  OPEN
  CLOSED
  AWARDED
}

enum PaymentTerm {
  CASH
  CREDIT
  CHEQUE
}

model RFQ {
  id                     String       @id @default(uuid())
  project_id             String
  project                Project      @relation(fields: [project_id], references: [id])
  created_by             String
  created_user           User         @relation(fields: [created_by], references: [id])
  status                 RFQStatus    @default(OPEN)
  deadline               DateTime?
  payment_terms          PaymentTerm?
  delivery_date_required DateTime?
  created_at             DateTime     @default(now())

  awarded_bid_id String? @unique
  awarded_bid    Bid?    @relation("RFQAwardedBid", fields: [awarded_bid_id], references: [id])

  items            RFQItem[]
  bids             Bid[]
  purchase_orders  PurchaseOrder[]
  attachments      RFQAttachment[]

  @@map("rfqs")
}

model RFQAttachment {
  id        String @id @default(uuid())
  rfq_id    String
  file_url  String
  file_name String
  rfq       RFQ    @relation(fields: [rfq_id], references: [id], onDelete: Cascade)

  @@map("rfq_attachments")
}

model RFQItem {
  id          String   @id @default(uuid())
  rfq_id      String
  rfq         RFQ      @relation(fields: [rfq_id], references: [id])
  boq_item_id String?
  boq_item    BOQItem? @relation(fields: [boq_item_id], references: [id])

  product_name String?  @db.VarChar(255)
  quantity     Decimal? @db.Decimal(12, 3)
  unit         String?  @db.VarChar(50)

  bid_items BidItem[]

  @@map("rfq_items")
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Bid {
  id          String  @id @default(uuid())
  rfq_id      String
  rfq         RFQ     @relation(fields: [rfq_id], references: [id])
  supplier_id String
  supplier    Company @relation("SupplierBids", fields: [supplier_id], references: [id])

  total_price Decimal?  @db.Decimal(15, 2)
  valid_until DateTime?
  status      BidStatus @default(PENDING)
  rejection_reason String? @db.Text
  created_at  DateTime  @default(now())

  items           BidItem[]
  purchase_orders PurchaseOrder[]
  rfq_awarded_as  RFQ?   @relation("RFQAwardedBid")

  @@map("bids")
}

model BidItem {
  id          String  @id @default(uuid())
  bid_id      String
  bid         Bid     @relation(fields: [bid_id], references: [id])
  rfq_item_id String
  rfq_item    RFQItem @relation(fields: [rfq_item_id], references: [id])

  unit_price Decimal? @db.Decimal(12, 2)
  note       String?  @db.Text

  @@map("bid_items")
}

// 4. Supply Chain & Partial Deliveries
// The core engine for "One Order, Many Deliveries" logic.
enum POStatus {
  CONFIRMED
  PROCESSING
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
}

model PurchaseOrder {
  id          String  @id @default(uuid())
  project_id  String
  project     Project @relation(fields: [project_id], references: [id])
  supplier_id String
  supplier    Company @relation("SupplierPOs", fields: [supplier_id], references: [id])
  bid_id      String?
  bid         Bid?    @relation(fields: [bid_id], references: [id])
  rfq_id      String?
  rfq         RFQ?    @relation(fields: [rfq_id], references: [id])

  payment_terms          PaymentTerm?
  delivery_date_required DateTime?

  status       POStatus @default(CONFIRMED)
  total_amount Decimal? @db.Decimal(15, 2)
  is_financed  Boolean  @default(false) // Flag for BNPL
  created_at   DateTime @default(now())

  items          POItem[]
  delivery_notes DeliveryNote[]
  invoices       Invoice[]

  transactions Transaction[]

  @@map("purchase_orders")
}

model POItem {
  id             String        @id @default(uuid())
  po_id          String
  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id])

  item_description String?  @db.VarChar(255)
  ordered_qty      Decimal? @db.Decimal(12, 3)
  unit_price       Decimal? @db.Decimal(12, 2)

  grn_items GRNItem[]

  @@map("po_items")
}

// Delivery Note / Goods Receipt Note (GRN) for Partial Delivery
enum DeliveryStatus {
  OUT_FOR_DELIVERY
  DELIVERED
}

model DeliveryNote {
  id             String        @id @default(uuid())
  po_id          String
  purchase_order PurchaseOrder @relation(fields: [po_id], references: [id])

  delivery_date DateTime       @default(now())
  status        DeliveryStatus @default(OUT_FOR_DELIVERY)

  pod_image_url     String? @db.Text
  pod_signature_url String? @db.Text

  received_by String?
  receiver    User?   @relation(fields: [received_by], references: [id])

  items GRNItem[]

  @@map("delivery_notes")
}

model GRNItem {
  id               String       @id @default(uuid())
  delivery_note_id String
  delivery_note    DeliveryNote @relation(fields: [delivery_note_id], references: [id])
  po_item_id       String
  po_item          POItem       @relation(fields: [po_item_id], references: [id])

  delivered_qty Decimal? @db.Decimal(12, 3)

  @@map("grn_items")
}

// 5. Financials & Compliance (ZATCA)
// Strict structure for Phase 2 Compliance and Chaining.
enum InvoiceStatus {
  DRAFT
  SUBMITTED
  CLEARED
  REPORTED
}

model Invoice {
  id             String         @id @default(uuid())
  po_id          String?
  purchase_order PurchaseOrder? @relation(fields: [po_id], references: [id])

  supplier_id String
  supplier    Company @relation("SupplierInvoices", fields: [supplier_id], references: [id])
  buyer_id    String
  buyer       Company @relation("BuyerInvoices", fields: [buyer_id], references: [id])

  // Financials
  subtotal     Decimal? @db.Decimal(15, 2)
  vat_amount   Decimal? @db.Decimal(15, 2)
  total_amount Decimal? @db.Decimal(15, 2)

  // ZATCA / ETA Compliance Fields
  invoice_number_sequence BigInt? // Sequential ID for chaining
  uuid                    String?   @db.VarChar(100) // ZATCA UUID
  issue_date              DateTime?
  previous_invoice_hash   String?   @db.Text
  current_invoice_hash    String?   @db.Text
  qr_code_data            String?   @db.Text // Base64 TLV data
  cryptographic_stamp     String?   @db.Text // Signed hash

  status     InvoiceStatus @default(DRAFT)
  created_at DateTime      @default(now())

  transactions Transaction[]

  @@map("invoices")
}

// 7. Company-level Settings (Notifications, Catalog, Admin config)
model CompanySettings {
  id         String  @id @default(uuid())
  company_id String  @unique
  company    Company @relation(fields: [company_id], references: [id])

  // Arbitrary JSON blobs for flexible MVP configuration
  notifications Json?
  catalog       Json?
  admin         Json?

  @@map("company_settings")
}

model AuditLog {
  id          String   @id @default(uuid())
  user_id     String
  company_id  String
  action      String
  entity_type String
  entity_id   String
  old_value   Json?
  new_value   Json?
  ip_address  String?
  user_agent  String?
  created_at  DateTime @default(now())

  @@index([created_at])
  @@index([entity_type, created_at])
  @@map("audit_logs")
}

// 6. Offline-First Sync
// Tables to support WatermelonDB synchronization.
enum SyncOperation {
  CREATE
  UPDATE
  DELETE
}

model SyncChange {
  id         String        @id @default(uuid())
  table_name String        @db.VarChar(50)
  record_id  String        @db.Uuid
  operation  SyncOperation
  changed_at DateTime      @default(now())
  user_id    String?
  user       User?         @relation(fields: [user_id], references: [id])

  @@map("sync_changes")
}

// 8. Daily Logs (Mobile Offline-First)
enum DailyLogStatus {
  DRAFT
  SUBMITTED
  SYNCED
}

model DailyLog {
  id           String         @id @default(uuid())
  project_id   String
  project      Project        @relation(fields: [project_id], references: [id])
  user_id      String
  user         User           @relation(fields: [user_id], references: [id])
  log_date     DateTime       @db.Date
  weather_data Json? // { temp: 30, condition: "Sunny" }
  attendance_data Json? // { "Carpenters": 5 }
  material_receipt_data Json? // List of received items
  status       DailyLogStatus @default(DRAFT)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  photos LogPhoto[]

  @@map("daily_logs")
}

model LogPhoto {
  id           String   @id @default(uuid())
  daily_log_id String
  daily_log    DailyLog @relation(fields: [daily_log_id], references: [id])
  local_path   String?  @db.Text
  s3_url       String?  @db.Text
  gps_lat      Decimal? @db.Decimal(10, 8)
  gps_long     Decimal? @db.Decimal(11, 8)

  created_at DateTime @default(now())

  @@map("log_photos")
}
